node_modules/
dist/
*.tsbuildinfo

# Runtime output from the CLI. Locks and the pricing cache live under
# ~/.turnlens/, so this is the only path the tool writes inside a project.
turnlens-usage/

# Development material. The published repository is the tool: source, tests and
# the README. Everything below is how it got built, and stays on the machine it
# was built on.
#
# docs/ is ignored as a directory rather than by listing what is in it, so a
# document written tomorrow is private by default and nobody has to remember a
# rule. .local/ is the same idea for files that are not documents and have no
# other obvious home.
docs/
documentation/
.local/

# Instructions and configuration for the agent used to develop this. CLAUDE.md
# is ignored where it sits because Claude Code reads it from the repository root.
CLAUDE.md
.claude/
