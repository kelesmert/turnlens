node_modules/
dist/
*.tsbuildinfo

# `npm pack` writes the tarball into the working directory.
*.tgz

# Runtime output from the CLI. Locks and the pricing cache live under
# ~/.turnlens/, so this is the only path the tool writes inside a project.
turnlens-usage/

# docs/ is working material for whoever develops this, not something a user of
# the package needs. It was tracked until 31 July 2026 and is kept out from here
# on; the files stay on the machines that use them. Anything a reader of the
# repository has to know belongs in README.md instead.
#
# .local/ is for files that are not documents and have no other obvious home.
docs/
.local/

# Instructions for the agent used to develop this are committed: AGENTS.md holds
# them, and CLAUDE.md is a symlink to it, because Claude Code reads that name
# while other agents read the first. `.claude/` is committed for the same reason
# -- it is written by hand. Only the permissions file Claude Code writes for
# itself stays on the machine it was written on.
.claude/settings.local.json
